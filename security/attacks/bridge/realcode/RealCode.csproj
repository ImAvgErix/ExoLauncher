<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Security attack harness. Compiles the REAL, unmodified Exo bridge source
    files (not copies) and exercises their trust, parse and dedup logic directly.
    Run (from this folder): dotnet run -c Release
    Exit code 0 = every assertion held; 1 = a check failed.
    This project is not part of the product build and is not referenced by it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Test the shipped behavior: Release disables the loopback dev-server escape hatch. -->
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ExoBridgeAttack</AssemblyName>
    <RootNamespace>ExoBridgeAttack</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real product source, compiled in place via Link. Paths are relative to this csproj. -->
    <Compile Include="..\..\..\..\ExoLauncher\Helpers\WebViewTrustPolicy.cs" Link="real\WebViewTrustPolicy.cs" />
    <Compile Include="..\..\..\..\ExoLauncher\Services\ExoBridgeProtocol.cs" Link="real\ExoBridgeProtocol.cs" />
    <Compile Include="..\..\..\..\ExoLauncher\Services\BridgeRequestRegistry.cs" Link="real\BridgeRequestRegistry.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
