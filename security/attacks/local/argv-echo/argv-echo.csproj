<Project Sdk="Microsoft.NET.Sdk">
  <!-- Harmless stub used by attack tests. Writes its argv (one arg per line)
       to the file named by env var ARGV_OUT, then exits. If ARGV_OUT is unset
       it stays alive (so it can serve as a long-lived target process). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>argv-echo</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
