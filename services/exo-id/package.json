{
  "name": "exo-id",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Optional Exo account API. Sign-in, reserved handles, portable profile and preference sync.",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "migrate:local": "wrangler d1 migrations apply exo-id --local",
    "types": "wrangler types"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-auth": "1.7.1",
    "hono": "4.13.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "^22.15.17",
    "typescript": "5.8.3",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}
