{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exo-id",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://exo-id.exo-erix.workers.dev",
    "GOOGLE_CLIENT_ID": "",
    "RESEND_FROM": ""
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exo-id",
      "database_id": "93cbfd74-45f1-4a26-823e-145fd232a636",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROFILE_MEDIA",
      "bucket_name": "exo-id-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "PresenceDurableObject"
      }
    ]
  },
  // SQLite-backed per-user presence. `exports` is mutually exclusive with the
  // legacy `migrations` array; do not add both.
  "exports": {
    "PresenceDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
