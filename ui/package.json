{
  "name": "exo-launcher-ui",
  "private": true,
  "version": "3.11.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm --prefix ../mouse run build && node scripts/build-cache.mjs record",
    "check": "npm run -s contracts && npm run -s lint && npm run -s lint:css",
    "contracts": "node scripts/check-host-contract.mjs",
    "contracts:write": "node scripts/check-host-contract.mjs --write",
    "lint": "eslint src --max-warnings 0",
    "lint:css": "node scripts/css-design.mjs && node scripts/glass-controls.mjs --check && node scripts/icons.mjs --check",
    "glass:controls": "node scripts/glass-controls.mjs",
    "icons": "node scripts/icons.mjs",
    "dead": "knip --no-progress && knip --production --no-progress -c knip.production.json",
    "css:prune": "node scripts/prune-dead-css.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dashjs": "4.7.4",
    "hls.js": "1.7.3",
    "lottie-web": "5.13.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/tabler": "1.2.41",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "knip": "^6.37.0",
    "oxc-transform-react": "^0.150.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
