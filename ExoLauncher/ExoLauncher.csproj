<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ExoLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <ApplicationIcon Condition="Exists('Assets\ExoLauncher.ico')">Assets\ExoLauncher.ico</ApplicationIcon>
    <AssemblyName>ExoLauncher</AssemblyName>
    <Product>Exo Launcher</Product>
    <Company>ImAvgErix</Company>
    <Description>One calm Windows library UI. Other store clients become invisible backends.</Description>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.3.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <!-- Asset archives can retain upstream timestamps. Always copy them so a
           rebuilt app never ships an older cue merely because its source date
           predates a previous publish. -->
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ui\src\lib\trophyBannerDesign.json" Link="trophyBannerDesign.json" Condition="Exists('..\ui\src\lib\trophyBannerDesign.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\CHANGELOG.md" Link="CHANGELOG.md" Condition="Exists('..\CHANGELOG.md')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\VERSION" Link="VERSION" Condition="Exists('..\VERSION')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildWebUi" Condition="Exists('$(MSBuildThisFileDirectory)..\ui\package.json')">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\ui\node_modules')" Text="ui/node_modules is missing. Run: cd ui &amp;&amp; npm ci. Refusing to package stale generated web assets." />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)..\ui" IgnoreExitCode="false" />
  </Target>

  <!--
    Vite emits content-hashed filenames and clears the output directory, so a
    wwwroot glob evaluated at project load names the *previous* build's assets
    and the copy step fails with MSB3030. Collect it after the UI build instead.
  -->
  <Target Name="CollectWebUi" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildWebUi">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)wwwroot\index.html')" Text="ExoLauncher/wwwroot/index.html missing. Run: cd ui &amp;&amp; npm ci &amp;&amp; npm run build" />
    <ItemGroup>
      <Content Include="wwwroot\**\*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <Target Name="BuildSteamIpc" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SteamIpcPub>$(MSBuildThisFileDirectory)..\ExoLauncher.SteamIpc\bin\x64\$(Configuration)\net10.0-windows10.0.26100.0\win-x64\publish\</_SteamIpcPub>
      <_SteamIpcOut>$(OutDir)steam-ipc\</_SteamIpcOut>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ExoLauncher.SteamIpc\ExoLauncher.SteamIpc.csproj" Targets="Publish" Properties="Configuration=$(Configuration);Platform=x64;RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(_SteamIpcPub)" />
    <MakeDir Directories="$(_SteamIpcOut)" />
    <ItemGroup>
      <_SteamIpcPubFiles Include="$(_SteamIpcPub)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SteamIpcPubFiles)" DestinationFolder="$(_SteamIpcOut)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_SteamIpcPubFiles)' != ''" />
  </Target>

  <Target Name="PublishSteamIpc" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SteamIpcPub>$(MSBuildThisFileDirectory)..\ExoLauncher.SteamIpc\bin\x64\$(Configuration)\net10.0-windows10.0.26100.0\win-x64\publish\</_SteamIpcPub>
      <_ExoPubSteam>$([System.IO.Path]::GetFullPath('$(PublishDir)'))steam-ipc\</_ExoPubSteam>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ExoLauncher.SteamIpc\ExoLauncher.SteamIpc.csproj" Targets="Publish" Properties="Configuration=$(Configuration);Platform=x64;RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(_SteamIpcPub)" />
    <MakeDir Directories="$(_ExoPubSteam)" />
    <ItemGroup>
      <_SteamIpcPubFiles Include="$(_SteamIpcPub)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SteamIpcPubFiles)" DestinationFolder="$(_ExoPubSteam)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_SteamIpcPubFiles)' != ''" />
  </Target>
</Project>
