<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Zip / prompt tokens. Void black. Not Fluent. -->
    <Color x:Key="ExoColorHairlineSoft">#161616</Color>
    <Color x:Key="ExoColorInk">#FFFFFF</Color>
    <Color x:Key="ExoColorCtaInk">#0A0A0A</Color>
    <Color x:Key="ExoColorMuted">#888888</Color>

    <SolidColorBrush x:Key="ExoDividerBrush" Color="{StaticResource ExoColorHairlineSoft}" />
    <SolidColorBrush x:Key="ExoPrimaryTextBrush" Color="{StaticResource ExoColorInk}" />
    <SolidColorBrush x:Key="ExoSecondaryTextBrush" Color="{StaticResource ExoColorMuted}" />
    <SolidColorBrush x:Key="ExoInverseFillBrush" Color="{StaticResource ExoColorInk}" />
    <SolidColorBrush x:Key="ExoInverseTextBrush" Color="{StaticResource ExoColorCtaInk}" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="ExoDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="ExoPrimaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="ExoSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="ExoInverseFillBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="ExoInverseTextBrush" ResourceKey="SystemColorWindowBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
