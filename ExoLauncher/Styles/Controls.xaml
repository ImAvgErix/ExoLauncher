<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ExoPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ExoInverseFillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ExoInverseTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ExoPillRadius}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontFamily" Value="{StaticResource ExoUiFont}" />
        <Setter Property="FontSize" Value="{StaticResource ExoTypeBodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ExoGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ExoPrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ExoDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ExoControlRadius}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource ExoUiFont}" />
        <Setter Property="FontSize" Value="{StaticResource ExoTypeUiSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ExoIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ExoSecondaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ExoControlRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ExoEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ExoUiFont}" />
        <Setter Property="FontSize" Value="{StaticResource ExoTypeEyebrowSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource ExoMutedTextBrush}" />
    </Style>

    <Style x:Key="ExoCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ExoCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ExoDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ExoCardRadius}" />
    </Style>
</ResourceDictionary>
