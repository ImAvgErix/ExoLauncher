<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ExoLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Exo Launcher">

    <Grid x:Name="RootGrid"
          Background="#000000"
          Padding="0"
          UseLayoutRounding="True"
          SizeChanged="RootGrid_SizeChanged">

        <Grid x:Name="ContentHost"
              Margin="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <WebView2 x:Name="WebHost"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      DefaultBackgroundColor="#000000" />
        </Grid>

        <Grid x:Name="AppTitleBar"
              Height="12"
              Margin="56,0,184,0"
              VerticalAlignment="Top"
              Background="Transparent"
              IsHitTestVisible="True" />

        <StackPanel x:Name="WebBootPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True"
                          Width="34"
                          Height="34"
                          HorizontalAlignment="Center" />
            <TextBlock x:Name="WebBootText"
                       Text="Starting Exo Launcher…"
                       Foreground="#B8B8BC"
                       FontSize="13"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="WebViewFallback"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="12">
            <TextBlock x:Name="WebViewFallbackTitle"
                       Text="Exo Launcher couldn't start its UI runtime"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock x:Name="WebViewFallbackBody"
                       Text="Install the WebView2 Runtime from Microsoft, then reopen Exo Launcher."
                       Foreground="#B8B8BC"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <Button x:Name="WebViewRestartButton"
                        Content="Restart"
                        Click="WebViewRestartButton_Click" />
                <Button x:Name="WebViewFallbackButton"
                        Content="Get WebView2"
                        Click="WebViewFallbackButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
