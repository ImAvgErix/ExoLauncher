<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ExoLauncher.Controls.GameTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PointerEntered="OnEntered"
    PointerExited="OnExited"
    PointerMoved="OnMoved"
    PointerPressed="OnPressed"
    PointerReleased="OnReleased"
    PointerCaptureLost="OnReleased">

    <Grid Width="160">
        <Button x:Name="Hit"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Click="Hit_Click">
            <StackPanel Spacing="10">
                <Grid x:Name="Frame"
                      Width="160"
                      Height="240">
                    <Border x:Name="ShadowHost"
                            Width="160"
                            Height="240"
                            IsHitTestVisible="False" />
                    <Border x:Name="CoverHost"
                            CornerRadius="14"
                            Background="{StaticResource ExoCardFillBrush}"
                            BorderBrush="{StaticResource ExoDividerBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Image x:Name="CoverImage"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed" />
                            <Rectangle x:Name="Spot"
                                       IsHitTestVisible="False"
                                       Opacity="0">
                                <Rectangle.Fill>
                                    <RadialGradientBrush x:Name="SpotBrush"
                                                         MappingMode="Absolute"
                                                         RadiusX="140"
                                                         RadiusY="140">
                                        <GradientStop Color="#38FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="Shine"
                                       IsHitTestVisible="False"
                                       Opacity="0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#40FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle VerticalAlignment="Top"
                                       Height="1"
                                       IsHitTestVisible="False"
                                       Fill="{StaticResource ExoEdgeBrush}" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Mono"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ExoMutedTextBrush}" />
                    <Rectangle x:Name="Develop"
                               VerticalAlignment="Bottom"
                               Height="3"
                               Fill="{StaticResource ExoInverseFillBrush}"
                               Visibility="Collapsed" />
                    <Border x:Name="UpdateBadge"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            Padding="8,3"
                            CornerRadius="999"
                            Background="{StaticResource ExoInverseFillBrush}"
                            Visibility="Collapsed">
                        <TextBlock Text="Update"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ExoInverseTextBrush}" />
                    </Border>
                    <Border x:Name="StoreChip"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8"
                            Padding="8,4"
                            CornerRadius="999"
                            Background="{StaticResource ExoChipBrush}">
                        <TextBlock x:Name="StoreText"
                                   FontSize="11"
                                   Foreground="{StaticResource ExoPrimaryTextBrush}" />
                    </Border>
                </Grid>
                <TextBlock x:Name="TitleText"
                           FontSize="{StaticResource ExoTypeUiSize}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ExoSecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </StackPanel>
        </Button>
        <Button x:Name="Pin"
                Width="28"
                Height="28"
                Margin="0,8,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#CC101010"
                BorderBrush="{StaticResource ExoDividerBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Click="Pin_Click"
                Visibility="Collapsed">
            <FontIcon x:Name="PinIcon" Glyph="&#xE734;" FontSize="11" />
        </Button>
    </Grid>
</UserControl>
