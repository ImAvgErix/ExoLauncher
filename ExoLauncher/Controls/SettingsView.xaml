<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ExoLauncher.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource ExoPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Height="52" Padding="16,0">
            <TextBlock Text="Settings"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource ExoDisplayFont}"
                       Foreground="{StaticResource ExoPrimaryTextBrush}" />
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="Back"
                    Style="{StaticResource ExoGhostButtonStyle}"
                    Click="Back_Click" />
            <Rectangle VerticalAlignment="Bottom"
                       Height="1"
                       Fill="{StaticResource ExoDividerBrush}" />
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="24,16,24,32">
            <StackPanel MaxWidth="640" Spacing="24">
                <TextBlock x:Name="Note" Visibility="Collapsed"
                           Foreground="{StaticResource ExoSecondaryTextBrush}"
                           TextWrapping="Wrap" />

                <Pivot>
                    <Pivot.Resources>
                        <SolidColorBrush x:Key="PivotHeaderForegroundUnselectedBrush" Color="#6E6E73" />
                        <SolidColorBrush x:Key="PivotHeaderForegroundSelectedBrush" Color="#F5F5F7" />
                    </Pivot.Resources>
                    <PivotItem Header="Library">
                        <StackPanel Spacing="16" Margin="0,20,0,0">
                            <TextBlock Text="Scan a folder, or set where installs go."
                                       FontSize="{StaticResource ExoTypeUiSize}"
                                       Foreground="{StaticResource ExoMutedTextBrush}" />
                            <Border Style="{StaticResource ExoCardBorderStyle}"
                                    Padding="18">
                                <StackPanel Spacing="0">
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Portable game"
                                                       FontSize="{StaticResource ExoTypeUiSize}"
                                                       Foreground="{StaticResource ExoPrimaryTextBrush}" />
                                            <TextBlock Text="Add a folder that already has a game in it."
                                                       FontSize="{StaticResource ExoTypeCaptionSize}"
                                                       Foreground="{StaticResource ExoMutedTextBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Add folder"
                                                Style="{StaticResource ExoGhostButtonStyle}"
                                                Click="AddFolder_Click" />
                                    </Grid>
                                    <Rectangle Height="1" Margin="0,12" Fill="{StaticResource ExoDividerBrush}" />
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Install folder"
                                                       FontSize="{StaticResource ExoTypeUiSize}"
                                                       Foreground="{StaticResource ExoPrimaryTextBrush}" />
                                            <TextBlock x:Name="InstallRoot"
                                                       TextWrapping="Wrap"
                                                       FontSize="{StaticResource ExoTypeCaptionSize}"
                                                       Foreground="{StaticResource ExoSecondaryTextBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Choose"
                                                Style="{StaticResource ExoGhostButtonStyle}"
                                                Click="ChooseRoot_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </PivotItem>
                    <PivotItem Header="Stores">
                        <StackPanel Spacing="12" Margin="0,20,0,0">
                            <TextBlock Text="Stores on this PC"
                                       Style="{StaticResource ExoEyebrowStyle}" />
                            <StackPanel x:Name="StoreList" Spacing="8" />
                        </StackPanel>
                    </PivotItem>
                    <PivotItem Header="Unlocks">
                        <StackPanel Spacing="16" Margin="0,20,0,0">
                            <Border Style="{StaticResource ExoCardBorderStyle}"
                                    Padding="18">
                                <StackPanel Spacing="16">
                                    <ToggleSwitch x:Name="TrophyToggle"
                                                  Header="Show unlocks"
                                                  Toggled="Trophy_Toggled" />
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Place"
                                                   FontSize="{StaticResource ExoTypeUiSize}"
                                                   Foreground="{StaticResource ExoMutedTextBrush}" />
                                        <ComboBox x:Name="TrophyPlace"
                                                  Width="220"
                                                  SelectionChanged="Place_Changed">
                                            <ComboBoxItem Content="Top left" Tag="top-left" />
                                            <ComboBoxItem Content="Top center" Tag="top-center" />
                                            <ComboBoxItem Content="Top right" Tag="top-right" />
                                            <ComboBoxItem Content="Bottom left" Tag="bottom-left" />
                                            <ComboBoxItem Content="Bottom center" Tag="bottom-center" />
                                            <ComboBoxItem Content="Bottom right" Tag="bottom-right" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Content="Preview"
                                            Style="{StaticResource ExoGhostButtonStyle}"
                                            Click="Preview_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </PivotItem>
                    <PivotItem Header="App">
                        <StackPanel Spacing="16" Margin="0,20,0,0">
                            <Border Style="{StaticResource ExoCardBorderStyle}"
                                    Padding="18">
                                <StackPanel Spacing="16">
                                    <TextBlock x:Name="VersionText"
                                               FontSize="{StaticResource ExoTypeUiSize}"
                                               Foreground="{StaticResource ExoSecondaryTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Check for update"
                                                Style="{StaticResource ExoGhostButtonStyle}"
                                                Click="CheckUpdate_Click" />
                                        <Button x:Name="InstallUpdateButton"
                                                Content="Install update"
                                                Style="{StaticResource ExoPrimaryButtonStyle}"
                                                Click="InstallUpdate_Click"
                                                Visibility="Collapsed" />
                                    </StackPanel>
                                    <ProgressBar x:Name="UpdateMeter" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </PivotItem>
                </Pivot>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
