<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ExoLauncher.Controls.GamePlate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="400"
    HorizontalAlignment="Right"
    IsHitTestVisible="False">
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="Drawer" X="400" />
    </UserControl.RenderTransform>

    <Border Width="400"
            HorizontalAlignment="Right"
            Background="{StaticResource ExoCardFillBrush}"
            BorderBrush="{StaticResource ExoDividerBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Rectangle VerticalAlignment="Top"
                       Height="1"
                       IsHitTestVisible="False"
                       Fill="{StaticResource ExoEdgeBrush}" />

            <Grid Padding="24,22" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="80"
                        Height="120"
                        CornerRadius="14"
                        Background="{StaticResource ExoRaisedFillBrush}"
                        BorderBrush="{StaticResource ExoDividerBrush}"
                        BorderThickness="1">
                    <Image x:Name="Cover" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="TitleText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource ExoDisplayFont}"
                               Foreground="{StaticResource ExoPrimaryTextBrush}" />
                    <TextBlock x:Name="StoreText"
                               Style="{StaticResource ExoEyebrowStyle}" />
                    <TextBlock x:Name="Facts"
                               FontSize="{StaticResource ExoTypeCaptionSize}"
                               Foreground="{StaticResource ExoSecondaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource ExoIconButtonStyle}"
                        VerticalAlignment="Top"
                        Click="Close_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <Rectangle Grid.Row="0"
                       VerticalAlignment="Bottom"
                       Height="1"
                       Fill="{StaticResource ExoDividerBrush}" />

            <ScrollViewer Grid.Row="1" Padding="24,16">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="Note"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource ExoTypeUiSize}"
                               Foreground="{StaticResource ExoMutedTextBrush}" />
                    <TextBlock x:Name="Upscaler"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource ExoTypeUiSize}"
                               Foreground="{StaticResource ExoSecondaryTextBrush}" />
                    <ProgressBar x:Name="Meter" Visibility="Collapsed" Height="2" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FolderButton"
                                Content="Folder"
                                Style="{StaticResource ExoGhostButtonStyle}"
                                Click="Folder_Click" />
                        <Button x:Name="RepairButton"
                                Content="Verify"
                                Style="{StaticResource ExoGhostButtonStyle}"
                                Click="Repair_Click" />
                        <Button x:Name="ApplyButton"
                                Content="Apply"
                                Style="{StaticResource ExoGhostButtonStyle}"
                                Click="Apply_Click" />
                    </StackPanel>
                    <HyperlinkButton x:Name="BuyLink"
                                     Content="Buy in browser"
                                     Click="Buy_Click"
                                     Foreground="{StaticResource ExoActionBrush}"
                                     Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Rectangle Grid.Row="2"
                       VerticalAlignment="Top"
                       Height="1"
                       Fill="{StaticResource ExoDividerBrush}" />

            <Grid Grid.Row="2" Padding="24,16" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryButton"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource ExoPrimaryButtonStyle}"
                        Click="Primary_Click"
                        PointerPressed="Primary_Pressed"
                        PointerReleased="Primary_Released"
                        PointerCaptureLost="Primary_Released" />
                <Button x:Name="RemoveButton"
                        Grid.Column="1"
                        Content="Remove"
                        Style="{StaticResource ExoGhostButtonStyle}"
                        Click="Remove_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
