<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pure-logic tests for the host. The running app stays the real verification
    (tools\e2e\Invoke-ExoE2E.ps1); these pin parsing, ownership and policy code
    whose failures are silent in the app.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.28000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The host is framework-dependent on the Windows App SDK; the test runner has no
         bootstrapper, so it carries the runtime itself. CI passes the same value. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\ExoLauncher\ExoLauncher.csproj" />
  </ItemGroup>

</Project>
